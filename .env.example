# UniPlan configuration. Copy to .env and fill in. NEVER commit .env.
# ---------- Uni data sources ----------
# Canvas: canvas.anu.edu.au -> Account -> Settings -> "+ New Access Token"
CANVAS_TOKEN=
# Gradescope direct login (the password you set, not ANU SSO)
GRADESCOPE_EMAIL=
GRADESCOPE_PASSWORD=
# Ed: https://edstem.org/au/settings/api-tokens -> Create token
ED_TOKEN=
# ANU timetable iCal subscription URL (webcal:// or https://)
TIMETABLE_URL=
# ---------- LLM ----------
# Gemini: https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
# ---------- Outlook (ANU mail) ----------
# Option 1: Entra app registration client ID (public client, delegated Mail.Read). Not a secret, but needed.
GRAPH_CLIENT_ID=
# Option 2 (fallback, only if Graph is blocked): Gmail that ANU mail is forwarded to + app password
# App password: myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# ---------- Generated for you (change if you like) ----------
# ntfy topic: subscribe to this exact name in the ntfy iPhone app
NTFY_TOPIC=
# Password your iPhone/Mac Calendar uses for the CalDAV account (username: uniplan)
CALDAV_PASSWORD=
# Password for the UniPlan web dashboard
WEB_PASSWORD=
# ---------- Non-secret settings ----------
TIMEZONE=Australia/Sydney
NIGHTLY_SYNC_TIME=02:00

# ---------- Optional (defaults shown) ----------
# Email: none | imap (Gmail that ANU mail is forwarded to) | applemail (ANU account added to Apple Mail)
EMAIL_SOURCE=none
# APPLEMAIL_ACCOUNT=ANU            # account name exactly as shown in Apple Mail's sidebar
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# OLLAMA_MODEL=phi4-mini:latest     # qwen3:8b recommended if you pull it (ollama pull qwen3:8b)
# LLM_LOOKBACK_DAYS=30
# WEB_PORT=8765
# CALDAV_PORT=5232
# PUBLIC_URL=https://your-mac.your-tailnet.ts.net:8443   # link used in push notifications
